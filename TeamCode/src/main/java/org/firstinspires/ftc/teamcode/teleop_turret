package org.firstinspires.ftc.teamcode;

import com.pedropathing.follower.Follower;
import com.pedropathing.geometry.Pose;

import com.qualcomm.robotcore.eventloop.opmode.OpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorEx;
import com.qualcomm.robotcore.hardware.DcMotorSimple;
import com.qualcomm.robotcore.hardware.PIDFCoefficients;
import com.qualcomm.robotcore.hardware.Servo;

import org.firstinspires.ftc.teamcode.pedro.Constants;

/**
 * Regional driver-controlled op mode. All controls are on gamepad 1:
 *   Left stick   - drive forward/backward, strafe side to side, and any angle in between
 *   Right stick  - turn (left/right)
 *   A            - toggle intake in
 *   B            - toggle intake out
 *   X            - toggle shoot motor on/off (velocity controlled)
 *   Y            - toggle gate open/closed
 *   D-pad Left   - select RED alliance   (also works during init)
 *   D-pad Right  - select BLUE alliance  (also works during init)
 *   Right bumper - toggle turret auto-aim on/off
 * With auto-aim on, the turret servo is updated every loop to point at the
 * selected alliance's HIVE. With it off, the turret holds TURRET_POSITION.
 * Servos are not commanded during init, so the robot stays still until PLAY is pressed.
 */
@TeleOp(name = "Regional TeleOp", group = "Competition")
public class RegionalTeleOp extends OpMode {

    // These must match the names in the active robot configuration.
    private static final String FRONT_LEFT_NAME = "frontLeft";
    private static final String FRONT_RIGHT_NAME = "frontRight";
    private static final String BACK_LEFT_NAME = "backLeft";
    private static final String BACK_RIGHT_NAME = "backRight";
    private static final String INTAKE_NAME = "intake";
    private static final String SHOOT_NAME = "shoot";
    private static final String GATE_NAME = "servo";
    private static final String TURRET_NAME = "turret";

    private static final double INTAKE_POWER = 0.78;

    // Gate positions measured with the Motor Toggle Test op mode.
    private static final double GATE_CLOSED = 0.21;
    private static final double GATE_OPEN = 0.13;

    // Fixed turret position used when auto-aim is switched off.
    private static final double TURRET_POSITION = 0.625;

    // Shoot motor speed in encoder ticks per second.
    // TODO: tune on the robot. These assume a 6000 RPM motor with 28 ticks per
    // revolution (2800 ticks/sec at full speed). F is about 32767 / max ticks per sec.
    private static final double SHOOT_VELOCITY = 1390;
    private static final double SHOOT_P = 10.0;
    private static final double SHOOT_I = 3.0;
    private static final double SHOOT_D = 0.0;
    private static final double SHOOT_F = 11.7;

    // ===== AUTO-AIM settings =====

    // Where the robot starts, in Pedro field coordinates (inches). Heading in radians.
    // TODO: change this to where the robot actually starts during TeleOp.
    private final Pose startPose = new Pose(83.8657, 132.8529, Math.toRadians(90));

    // Target coordinates for each HIVE. TODO: double-check these on the field.
    private static final double RED_HIVE_X = 56.0;
    private static final double RED_HIVE_Y = 56.0;
    private static final double BLUE_HIVE_X = 84.0;
    private static final double BLUE_HIVE_Y = 85.0;

    // Turret pivot offset from the robot's center point, in inches.
    // Positive X is forward and positive Y is left. TODO: measure these.
    private static final double PIVOT_OFFSET_X = 0.0;
    private static final double PIVOT_OFFSET_Y = 0.0;

    // Servo calibration. TODO: adjust after testing the servo.
    private static final double SERVO_CENTER = 0.50;
    private static final double SERVO_MIN_COMMAND = 0.05;
    private static final double SERVO_MAX_COMMAND = 0.95;

    // Turret movement limit either side of straight ahead. TODO: check the real range.
    private static final double MAX_TURRET_ANGLE_DEG = 150.0;

    // Change to -1 if the turret turns in the opposite direction.
    private static final double SERVO_DIRECTION = 1.0;

    // Whether auto-aim is on when the match starts.
    private static final boolean AUTO_AIM_AT_START = true;

    private enum IntakeState { OFF, IN, OUT }

    private DcMotor frontLeft;
    private DcMotor frontRight;
    private DcMotor backLeft;
    private DcMotor backRight;
    private DcMotor intake;
    private DcMotorEx shoot;
    private Servo gate;
    private Servo turret;

    private IntakeState intakeState = IntakeState.OFF;
    private boolean shootOn = false;
    private boolean gateOpen = false;

    // AUTO-AIM state
    private Follower follower;
    private boolean redAlliance = true;
    private boolean autoAim = AUTO_AIM_AT_START;
    private double turretTargetDegrees = 0.0;

    @Override
    public void init() {
        frontLeft = hardwareMap.get(DcMotor.class, FRONT_LEFT_NAME);
        frontRight = hardwareMap.get(DcMotor.class, FRONT_RIGHT_NAME);
        backLeft = hardwareMap.get(DcMotor.class, BACK_LEFT_NAME);
        backRight = hardwareMap.get(DcMotor.class, BACK_RIGHT_NAME);

        // The left side is mounted mirrored, so it runs reversed to drive forward.
        frontLeft.setDirection(DcMotorSimple.Direction.REVERSE);
        backLeft.setDirection(DcMotorSimple.Direction.FORWARD);
        frontRight.setDirection(DcMotorSimple.Direction.REVERSE);
        backRight.setDirection(DcMotorSimple.Direction.REVERSE);

        for (DcMotor motor : new DcMotor[] {frontLeft, frontRight, backLeft, backRight}) {
            motor.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
            motor.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        }

        intake = hardwareMap.get(DcMotor.class, INTAKE_NAME);
        intake.setDirection(DcMotorSimple.Direction.FORWARD);
        intake.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);

        // DcMotorEx gives access to setVelocity() and the built-in velocity PIDF loop.
        // FLOAT lets the flywheel coast down instead of braking hard.
        shoot = hardwareMap.get(DcMotorEx.class, SHOOT_NAME);
        shoot.setDirection(DcMotorSimple.Direction.FORWARD);
        shoot.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.FLOAT);
        shoot.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        shoot.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        shoot.setPIDFCoefficients(DcMotor.RunMode.RUN_USING_ENCODER, new PIDFCoefficients(300, 0, 5, 10));
        gate = hardwareMap.get(Servo.class, GATE_NAME);
        turret = hardwareMap.get(Servo.class, TURRET_NAME);

        // AUTO-AIM: set up Pedro so we know where the robot is on the field.
        follower = Constants.create(hardwareMap);
        follower.setPose(startPose);

        telemetry.addData("Status", "Initialized");
        telemetry.update();
    }

    @Override
    public void init_loop() {
        // AUTO-AIM: pick the alliance before the match starts.
        if (gamepad1.dpad_left) redAlliance = true;
        if (gamepad1.dpad_right) redAlliance = false;

        telemetry.addLine("D-pad Left = RED, D-pad Right = BLUE");
        telemetry.addData("Alliance", redAlliance ? "RED" : "BLUE");
        telemetry.addData("Auto-aim at start", AUTO_AIM_AT_START ? "ON" : "OFF");
        telemetry.update();
    }

    @Override
    public void start() {
        // With auto-aim off, the turret holds this fixed position.
        turret.setPosition(TURRET_POSITION);
        gate.setPosition(GATE_CLOSED);

        // Discard presses from before PLAY (such as Start + A to assign the gamepad)
        // so nothing switches on by itself on the first loop.
        gamepad1.aWasPressed();
        gamepad1.bWasPressed();
        gamepad1.xWasPressed();
        gamepad1.yWasPressed();
        gamepad1.dpadLeftWasPressed();
        gamepad1.dpadRightWasPressed();
        gamepad1.rightBumperWasPressed();
    }

    @Override
    public void loop() {
        // AUTO-AIM: refresh the robot's position first.
        follower.update();

        drive();
        updateIntake();
        updateShooter();
        updateGate();
        updateAlliance();
        updateTurret();

        Pose pose = follower.getPose();

        telemetry.addData("Intake", intakeState);
        telemetry.addData("Shooter", shootOn ? "ON" : "OFF");
        telemetry.addData("Shooter Target", "%.0f ticks/sec", shootOn ? SHOOT_VELOCITY : 0.0);
        telemetry.addData("Shooter Velocity", "%.0f ticks/sec", shoot.getVelocity());
        telemetry.addData("Gate", gateOpen ? "OPEN" : "CLOSED");
        telemetry.addData("Alliance", redAlliance ? "RED" : "BLUE");
        telemetry.addData("Auto-aim", autoAim ? "ON" : "OFF");
        telemetry.addData("Robot X", "%.2f", pose.getX());
        telemetry.addData("Robot Y", "%.2f", pose.getY());
        telemetry.addData("Robot Heading", "%.2f deg", Math.toDegrees(pose.getHeading()));
        telemetry.addData("Turret Target Angle", "%.2f deg", turretTargetDegrees);
        telemetry.addData("Turret Servo", "%.2f", turret.getPosition());
        telemetry.update();
    }

    @Override
    public void stop() {
        frontLeft.setPower(0.0);
        frontRight.setPower(0.0);
        backLeft.setPower(0.0);
        backRight.setPower(0.0);
        intake.setPower(0.0);
        shoot.setPower(0.0);
    }

    private void drive() {
        double y = -gamepad1.left_stick_y; // Remember, Y stick value is reversed
        double x = gamepad1.left_stick_x * 1.1; // Counteract imperfect strafing
        double rx = gamepad1.right_stick_x;

        // Scale everything down together so a combined move keeps its direction
        // instead of clipping at full power.
        double denominator = Math.max(Math.abs(y) + Math.abs(x) + Math.abs(rx), 1);
        double frontLeftPower = (y + x + rx) / denominator;
        double backLeftPower = (y - x + rx) / denominator;
        double frontRightPower = (y - x - rx) / denominator;
        double backRightPower = (y + x - rx) / denominator;

        frontLeft.setPower(frontLeftPower);
        backLeft.setPower(backLeftPower);
        frontRight.setPower(frontRightPower);
        backRight.setPower(backRightPower);
    }

    private void updateIntake() {
        // Pressing the active direction again stops the intake. Pressing the other
        // direction switches straight to it.
        if (gamepad1.aWasPressed()) {
            intakeState = intakeState == IntakeState.IN ? IntakeState.OFF : IntakeState.IN;
        }
        if (gamepad1.bWasPressed()) {
            intakeState = intakeState == IntakeState.OUT ? IntakeState.OFF : IntakeState.OUT;
        }

        switch (intakeState) {
            case IN:
                intake.setPower(INTAKE_POWER);
                break;
            case OUT:
                intake.setPower(-INTAKE_POWER);
                break;
            default:
                intake.setPower(0.0);
                break;
        }
    }

    private void updateShooter() {
        if (gamepad1.xWasPressed()) {
            shootOn = !shootOn;
            if (shootOn) {
                shoot.setVelocity(SHOOT_VELOCITY);
            } else {
                shoot.setPower(0.0);
            }
        }
    }

    private void updateGate() {
        if (gamepad1.yWasPressed()) {
            gateOpen = !gateOpen;
            gate.setPosition(gateOpen ? GATE_OPEN : GATE_CLOSED);
        }
    }

    // AUTO-AIM: alliance selection during the match.
    private void updateAlliance() {
        if (gamepad1.dpadLeftWasPressed()) {
            redAlliance = true;
        }
        if (gamepad1.dpadRightWasPressed()) {
            redAlliance = false;
        }
    }

    // AUTO-AIM: point the turret at the HIVE, or hold the fixed position.
    private void updateTurret() {
        if (gamepad1.rightBumperWasPressed()) {
            autoAim = !autoAim;
            if (!autoAim) {
                turret.setPosition(TURRET_POSITION);
            }
        }

        if (autoAim) {
            aimTurret(follower.getPose());
        }
    }

    // Keeps an angle between -PI and PI.
    private double normalizeRadians(double angle) {
        while (angle > Math.PI) {
            angle -= 2 * Math.PI;
        }
        while (angle < -Math.PI) {
            angle += 2 * Math.PI;
        }
        return angle;
    }

    // AUTO-AIM: works out the turret angle and sets the servo.
    private void aimTurret(Pose robotPose) {
        double robotX = robotPose.getX();
        double robotY = robotPose.getY();
        double robotHeading = robotPose.getHeading();

        double targetX = redAlliance ? RED_HIVE_X : BLUE_HIVE_X;
        double targetY = redAlliance ? RED_HIVE_Y : BLUE_HIVE_Y;

        // Where the turret pivot is on the field.
        double pivotX = robotX
                + PIVOT_OFFSET_X * Math.cos(robotHeading)
                - PIVOT_OFFSET_Y * Math.sin(robotHeading);
        double pivotY = robotY
                + PIVOT_OFFSET_X * Math.sin(robotHeading)
                + PIVOT_OFFSET_Y * Math.cos(robotHeading);

        // Direction from the turret to the HIVE, then relative to the robot.
        double targetAngle = Math.atan2(targetY - pivotY, targetX - pivotX);
        double turretAngle = normalizeRadians(targetAngle - robotHeading);
        turretTargetDegrees = Math.toDegrees(turretAngle);

        // Keep the angle inside the turret's range.
        double limitedAngle = Math.max(
                -MAX_TURRET_ANGLE_DEG,
                Math.min(MAX_TURRET_ANGLE_DEG, turretTargetDegrees)
        );

        // Angle -> servo position.
        double fraction = (limitedAngle + MAX_TURRET_ANGLE_DEG)
                / (2.0 * MAX_TURRET_ANGLE_DEG);

        double servoPosition = SERVO_MIN_COMMAND
                + fraction * (SERVO_MAX_COMMAND - SERVO_MIN_COMMAND);

        servoPosition = SERVO_CENTER
                + SERVO_DIRECTION * (servoPosition - SERVO_CENTER);

        servoPosition = Math.max(
                SERVO_MIN_COMMAND,
                Math.min(SERVO_MAX_COMMAND, servoPosition)
        );

        turret.setPosition(servoPosition);
    }
}
